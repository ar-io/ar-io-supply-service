# All variables are optional — the service boots with sane defaults and no
# secrets are required. Copy to .env for docker compose, or set these as
# systemd environment variables in production.

# Solana JSON-RPC endpoint to read AR.IO supply accounts from.
# The public default below is rate-limited and NOT recommended for a
# production, publicly-hit endpoint — use a dedicated RPC provider
# (Helius, Triton, QuickNode, etc) in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How long a successful Solana read is reused before the next request
# triggers a refetch. Also sent as the Cache-Control max-age.
CACHE_TTL_SECONDS=60

# Per-IP request budget per minute.
RATE_LIMIT_PER_MIN=300

# pino log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# HTTP port the service listens on.
PORT=3031
